{
  "expo": {
    "name": "Elite Education",
    "slug": "elite-education",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eliteeducation",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "me.eliteeducation.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "me.eliteeducation.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Elite Education",
      "themeColor": "#0A0A0A"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#C9A84C"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Elite Education uses your photo library so you can hand in homework and share classwork.",
          "cameraPermission": "Elite Education uses your camera so you can photograph homework to hand in.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
