# Copy to .env and fill in to use your real Supabase project.
# Leave these unset to run the app on built-in demo data.
#
# Both values are safe to ship inside the app (the anon key only allows what
# row-level security permits). NEVER put the service_role key or Stripe secret
# keys here — those belong in Supabase Edge Function secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
