# Optional. The app connects to the Elite Education Supabase project by default (see src/config.ts).
#
# Run on built-in demo data instead of the live database:
# EXPO_PUBLIC_DEMO=1
#
# Point at a different Supabase project (publishable/anon key only — never the service_role key):
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
